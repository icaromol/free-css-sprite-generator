{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "/shared/*": ["./shared/*"]
    }
  },
  "include": ["scripts/**/*.mjs", "shared/**/*.mjs", "tools/**/*.mjs", "tools/**/*.js"],
  "exclude": ["node_modules", "art", "exports", "styles"]
}
